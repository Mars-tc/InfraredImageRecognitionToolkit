{
  "package": {
    "productName": "红外照片分析工具",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": [
        "deb",
        "msi"
      ],
      "identifier": "com.ir-inspection.tool",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico"
      ],
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37"
        ]
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "红外照片分析工具",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "build": {
    "devPath": "http://127.0.0.1:5173",
    "distDir": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "withGlobalTauri": true
  }
}
